# ==========================================
# KEOVIP247 - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Admin Authentication
# Mật khẩu đăng nhập vào trang /admin (Mặc định: admin123456)
ADMIN_PASSWORD=admin123456
ADMIN_SECRET=keovip-super-secret-key-2026-production

# 2. Database: Upstash Redis (Serverless KV)
# Đăng ký miễn phí tại https://console.upstash.com/ -> Create Database (Redis) -> REST API
# (Nếu chưa có, website vẫn tự động fallback lưu trữ an toàn trong memory để trải nghiệm đầy đủ)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# 3. Media Storage: ImageKit.io
# Đăng ký miễn phí tại https://imagekit.io/ -> Developer Options -> API Keys
# (Nếu chưa có, hệ thống hỗ trợ nhập link ảnh trực tiếp hoặc lưu Base64 tạm thời)
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# 4. App URL (Dùng cho OpenGraph & Sitemap)
NEXT_PUBLIC_SITE_URL=https://keovip247.com
